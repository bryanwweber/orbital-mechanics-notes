ldren":[{"type":"tabItem","title":"Python","sync":"python","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"min_altitude = np.min(altitude)\ni_min = np.argmin(altitude)\n\nmax_altitude = np.max(altitude)\ni_max = np.argmax(altitude)\n\nspeed_at_min_alt = speed[i_min]\nspeed_at_max_alt = speed[i_max]\ntime_at_min_alt = sol.t[i_min]\ntime_at_max_alt = sol.t[i_max]","key":"JQCBgSXzsp"},{"type":"outputs","id":"S3Px9ptADUyC9J7IlO9Wv","children":[],"key":"mRmIv6OirC"}],"key":"EeXAr8rvdp"}],"key":"VvK1NEvBjh"},{"type":"tabItem","title":"Matlab","sync":"matlab","children":[{"type":"include","file":"assets/two_body_relative_numerical_solution.m","literal":true,"filter":{"startAfter":"[section-6]","endBefore":"[section-7]"},"children":[{"type":"code","value":"    [min_altitude, imin] = min(altitude);\n    [max_altitude, imax] = max(altitude);\n    \n    speed_at_min_alt = speed(imin);\n    speed_at_max_alt = speed(imax); \n    time_at_min_alt = t(imin);\n    time_at_max_alt = t(imax);    \n    ","lang":"matlab","filename":"two_body_relative_numerical_solution.m","key":"nxAQgrWfW6"}],"key":"JGRq1Y7qAl"}],"key":"xyYw5wNob9"}],"key":"Glw8F2VDjj"},{"type":"paragraph","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"children":[{"type":"text","value":"Finally, we can print the results to the screen.","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"key":"AV4wsdivyC"}],"key":"sewQ7DEihY"},{"type":"tabSet","children":[{"type":"tabItem","title":"Python","sync":"python","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(\n    f\"\"\"\\\nThe minimum altitude during the orbit is: {min_altitude:.2F} km\nThe speed at the minimum altitude is: {speed_at_min_alt:.2F} km/s\nThe time at minimum altitude is: {time_at_min_alt:.2F} s\nThe maximum altitude during the orbit is: {max_altitude:.2F} km\nThe velocity at the maximum altitude is: {speed_at_max_alt:.4F} km/s\nThe time at maximum altitude is: {time_at_max_alt:.2F} s\n\"\"\"\n)","key":"H8xGVwNddF"},{"type":"outputs","id":"YUtW2dphkmKKNbF6qi6jQ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"The minimum altitude during the orbit is: 3621.88 km\nThe speed at the minimum altitude is: 7.00 km/s\nThe time at minimum altitude is: 0.00 s\nThe maximum altitude during the orbit is: 9431.85 km\nThe velocity at the maximum altitude is: 4.4353 km/s\nThe time at maximum altitude is: 7288.24 s\n\n"},"key":"TyrrIOzjKK"}],"key":"F7Dh6dqpJl"}],"key":"ZoBw19QmP3"}],"key":"TycsVk2apK"},{"type":"tabItem","title":"Matlab","sync":"matlab","children":[{"type":"include","file":"assets/two_body_relative_numerical_solution.m","literal":true,"filter":{"startAfter":"[section-7]","endBefore":"[section-8]"},"children":[{"type":"code","value":"    fprintf('The minimum altitude during the orbit is: %8.2f km\\n', min_altitude)\n    fprintf('The speed at the minimum altitude is: %8.2f km/s\\n', speed_at_min_alt)\n    fprintf('The time at minimum altitude is: %8.2f s\\n', time_at_min_alt)\n    fprintf('The maximum altitude during the orbit is: %8.2f km\\n', max_altitude)\n    fprintf('The speed at the maximum altitude is: %8.2f km/s\\n', speed_at_max_alt)\n    fprintf('The time at maximum altitude is: %8.2f s\\n', time_at_max_alt)\n","lang":"matlab","filename":"two_body_relative_numerical_solution.m","key":"xJ2iMWr3EA"}],"key":"FB4kX339XC"}],"key":"k6rYd6w8An"}],"key":"klJoCgoLoD"},{"type":"paragraph","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"children":[{"type":"text","value":"Interestingly, the results from Python and Matlab are slightly different. This is most likely because of different time resolution from the solvers. Now let’s plot the orbit. The central sphere is representative of the Earth.","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"key":"Ppi9GKDbvd"}],"key":"vMpZHbax1F"},{"type":"tabSet","children":[{"type":"tabItem","title":"Python","sync":"python","children":[{"type":"code","lang":"python","value":"fig = plt.figure()\nax = fig.add_subplot(111, projection=\"3d\")\nax.plot(r[:, 0], r[:, 1], r[:, 2], label=\"Orbit\")\nax.set_xlabel(\"km\")\nax.set_ylabel(\"km\")\nax.set_zlabel(\"km\")\n\n# This adds a sphere to the plot of the radius of the Earth\np = np.linspace(0, np.pi, 200)\nt = np.linspace(0, 2 * np.pi, 200)\nP, T = np.meshgrid(p, t)\n\nX = R_E * np.cos(T) * np.sin(P)\nY = R_E * np.sin(T) * np.sin(P)\nZ = R_E * np.cos(P)\n\nax.plot_surface(X, Y, Z)\nax.plot(r[i_min, 0], r[i_min, 1], r[i_min, 2], \"ro\", label=\"Min. Altitude\")\nax.plot(r[i_max, 0], r[i_max, 1], r[i_max, 2], \"go\", label=\"Max. Altitude\")\n_ = ax.legend()","position":{"start":{"line":259,"column":1},"end":{"line":280,"column":1}},"key":"Ut5s9xDk9k"}],"key":"T3ISWWLQxq"},{"type":"tabItem","title":"Matlab","sync":"matlab","children":[{"type":"include","file":"assets/two_body_relative_numerical_solution.m","literal":true,"filter":{"startAfter":"[section-8]","endBefore":"[section-9]"},"children":[{"type":"code","value":"    figure()\n    [xx, yy, zz] = sphere(200);\n    surf(RE*xx, RE*yy, RE*zz)\n    colormap(light_blue)\n    caxis([-RE/100 RE/100])\n    shading interp\n\n    %   Draw and label the X, Y and Z axes\n    line([0 2*RE], [0 0], [0 0]);\n    text(2*RE + RE/10, 0, 0, 'x')\n    line([0 0], [0 2*RE], [0 0]);\n    text(0, 2*RE + RE/10, 0, 'y')\n    line([0 0], [0 0], [0 2*RE]);\n    text(0, 0, 2*RE + RE/10, 'z')\n\n    hold on\n    plot3(rvec(:,1), rvec(:,2), rvec(:,3), 'k')\n    plot3(rvec(imin,1), rvec(imin,2), rvec(imin,3), '.r')\n    text(rvec(imin,1), rvec(imin,2), rvec(imin,3), 'Min. Altitude')\n    plot3(rvec(imax,1), rvec(imax,2), rvec(imax,3), '.g')\n    text(rvec(imax,1), rvec(imax,2), rvec(imax,3), 'Max. Altitude')\n\n    view([1,1,.4])\n\n    %   Specify some properties of the graph\n    grid on\n    axis equal\n    xlabel('km')\n    ylabel('km')\n    zlabel('km')\n \n    function map = light_blue\n        r = 0.8; g = r; b = 1.0;\n        map = [r g b\n               0 0 0\n               r g b];\n    end\n","lang":"matlab","filename":"two_body_relative_numerical_solution.m","key":"RIY44VTn69"}],"key":"kil9o1Wfzs"}],"key":"YGnr2bEB84"}],"key":"BXiEv9iRJt"},{"type":"container","kind":"figure","label":"fig:two-body-relative","identifier":"fig:two-body-relative","children":[{"type":"iframe","src":"/chapters/the-n-body-problem/assets/two-body-relative.html","title":"Satellite motion relative to the Earth","width":"100%","children":[{"type":"image","placeholder":true,"url":"/_public/relative-5816842ce788f9e0538d983775bb7755.png","alt":"Satellite motion relative to the Earth","key":"VGOggMCaGs","urlSource":"../../assets/threejs-placeholders/relative.png","urlOptimized":"/_public/relative-5816842ce788f9e0538d983775bb7755.webp"}],"key":"a7gVM4N4YL"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":298,"column":1},"end":{"line":298,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig:two-body-relative","identifier":"fig:two-body-relative","html_id":"fig-two-body-relative","enumerator":"13","children":[{"type":"text","value":"Figure ","key":"vlhEtmtsgJ"},{"type":"text","value":"13","key":"FjZfrDJJMN"},{"type":"text","value":":","key":"xgzsa9I2gX"}],"template":"Figure %s:","key":"rNrG9VBn6h"},{"type":"text","value":"The motion of a satellite in orbit around the Earth.","position":{"start":{"line":298,"column":1},"end":{"line":298,"column":1}},"key":"LMhcMT60ZS"}],"key":"m61trCUJ7Q"}],"key":"ahvw3vUwJL"}],"enumerator":"13","html_id":"fig-two-body-relative","key":"XPuSRU5VTK"}],"key":"EK3e8NC8QF"}],"key":"m3p3bcxJUl"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Relative Motion in the Two-Body Problem","url":"/the-n-body-problem/two-body-relative-motion","g