{"version":3,"kind":"Article","sha256":"83ed689d90e7a210a7b0b94eb9aae6a1a85684a7eafdceebd413ddd767cff4c8","slug":"classical-orbital-elements.right-ascension-declination","location":"/chapters/classical-orbital-elements/right-ascension-declination.md","dependencies":[],"frontmatter":{"title":"Right Ascension and Declination Coordinates","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Bryan Weber","given":"Bryan","family":"Weber"},"name":"Bryan Weber","orcid":"0000-0003-0815-9270","email":"bryan@bryanwweber.com","url":"https://bryanwweber.com","github":"bryanwweber","id":"contributors-myst-generated-uid-0","corresponding":true}],"open_access":true,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","free":true,"CC":true}},"github":"https://github.com/bryanwweber/orbital-mechanics-notes","numbering":{"figure":{"enabled":true,"template":"Fig. %s","continue":true},"equation":{"enabled":true,"template":"Eq. %s","continue":true},"table":{"enabled":true,"template":"Table %s","continue":true},"title":{"offset":1}},"math":{"\\vector":{"macro":"\\boldsymbol{#1}"},"\\uvec":{"macro":"\\boldsymbol{\\hat{#1}}"},"\\mag":{"macro":"\\lVert#1\\rVert"},"\\cross":{"macro":"\\times"},"\\unit":{"macro":"#1~\\mathrm{#2}"},"\\pf":{"macro":"{#1}_{\\omega}"},"\\mat":{"macro":"\\left[\\mathbf{#1}\\right]"},"\\COG":{"macro":"\\mathrm{COG}"},"\\KE":{"macro":"\\mathrm{KE}"},"\\PE":{"macro":"V"}},"source_url":"https://github.com/bryanwweber/orbital-mechanics-notes/blob/main/chapters/classical-orbital-elements/right-ascension-declination.md","edit_url":"https://github.com/bryanwweber/orbital-mechanics-notes/edit/main/chapters/classical-orbital-elements/right-ascension-declination.md","thumbnail":"/_public/Ra_and_dec_on_celest-f821c7c3c57dfd315d0ae8d814a31b06.png","thumbnailOptimized":"/_public/Ra_and_dec_on_celest-f821c7c3c57dfd315d0ae8d814a31b06.webp","exports":[{"format":"md","filename":"right-ascension-declination.md","url":"/_public/right-ascension-decl-3b1621de5359a48613b0395a80413d1c.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"To the human eye, from the surface of the Earth, stars and other objects in the night sky appear as points on a sphere surrounding the Earth. This sphere is called the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Dynqu6OBZW"},{"type":"link","url":"/reference/celestial-sphere","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"celestial sphere","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IYPComWx8V"}],"urlSource":"../reference/celestial-sphere.md","dataUrl":"/reference.celestial-sphere.json","internal":true,"protocol":"file","key":"nwFYftJvgG"},{"type":"text","value":". The points on the celestial sphere appear in the same location at the same time of night throughout the year, even as the Earth orbits the Sun. This is because most stars are so far away that the scale of motion in the solar system is not enough to change our perspective on them, so they appear to be fixed to the sphere.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hJW3NHdCxc"}],"key":"n4nQCKDDdo"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Since the stars are fixed, we can identify their positions on the celestial sphere and use them as reference points to determine orbital parameters. The reference frame used to describe these positions is similar to the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"A2zADoLIKu"},{"type":"crossReference","kind":"heading","identifier":"sec:earth-centered-inertial","label":"sec:earth-centered-inertial","children":[{"type":"text","value":"Earth-Centered Inertial","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"QeLnsohWb6"}],"template":"{name}","resolved":true,"html_id":"sec-earth-centered-inertial","remote":true,"url":"/intro/reference-frames","dataUrl":"/intro.reference-frames.json","key":"NayOTdDQQG"},{"type":"text","value":" frame. However, the celestial sphere uses spherical coordinates rather than Cartesian. Due to the huge distances to the visible stars, the radial distance is not important, and we only care about the angular position.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"hmm0Xl8zqX"}],"key":"xqMaIHADyu"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Celestial Coordinate System","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"fzdVbHJHXr"}],"identifier":"celestial-coordinate-system","label":"Celestial Coordinate System","html_id":"celestial-coordinate-system","implicit":true,"key":"MJ5cSbp2J4"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/_public/Ra_and_dec_on_celest-f821c7c3c57dfd315d0ae8d814a31b06.png","alt":"The coordinate system on the celestial sphere. Tfr000 (talk) 15:34, 15 June 2012 (UTC), CC BY-SA 3.0, via Wikimedia Commons.","width":"50%","data":{"altTextIsAutoGenerated":true},"key":"oqVD8ylyq9","urlSource":"../../images/Ra_and_dec_on_celestial_sphere.png","urlOptimized":"/_public/Ra_and_dec_on_celest-f821c7c3c57dfd315d0ae8d814a31b06.webp"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"fig:Ra_and_dec_on_celestial_sphere","identifier":"fig:ra_and_dec_on_celestial_sphere","html_id":"fig-ra-and-dec-on-celestial-sphere","enumerator":"43","children":[{"type":"text","value":"Figure ","key":"TZd0LO7st8"},{"type":"text","value":"43","key":"EfP1maJtmi"},{"type":"text","value":":","key":"uKUGyYtOqf"}],"template":"Figure %s:","key":"vHiudBLpg6"},{"type":"text","value":"The coordinate system on the celestial sphere. ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"aNju0VQiFz"},{"type":"link","url":"https://commons.wikimedia.org/wiki/File:Ra_and_dec_on_celestial_sphere.png","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Tfr000 (talk) 15:34, 15 June 2012 (UTC)","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"WShqqaa8VG"}],"urlSource":"https://commons.wikimedia.org/wiki/File:Ra_and_dec_on_celestial_sphere.png","key":"CjjO6fDBwg"},{"type":"text","value":", ","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ioD6uM4rg9"},{"type":"link","url":"https://creativecommons.org/licenses/by-sa/3.0","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"CC BY-SA 3.0","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"G57HbJLzYz"}],"urlSource":"https://creativecommons.org/licenses/by-sa/3.0","key":"Q310XHEGLZ"},{"type":"text","value":", via Wikimedia Commons.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"VoDismF1mZ"}],"key":"flXz3hl42b"}],"key":"OiSeiW9VrW"}],"label":"fig:Ra_and_dec_on_celestial_sphere","identifier":"fig:ra_and_dec_on_celestial_sphere","enumerator":"43","html_id":"fig-ra-and-dec-on-celestial-sphere","key":"cE7LOpRSFd"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"The celestial sphere is shown in ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"rYuRjNICHv"},{"type":"crossReference","identifier":"fig:ra_and_dec_on_celestial_sphere","label":"fig:Ra_and_dec_on_celestial_sphere","kind":"figure","position":{"start":{"line":16,"column":34},"end":{"line":16,"column":69}},"children":[{"type":"text","value":"Fig. ","key":"cqCT8Cui2i"},{"type":"text","value":"43","key":"Ga7y7rpa0G"}],"template":"Fig. %s","enumerator":"43","resolved":true,"html_id":"fig-ra-and-dec-on-celestial-sphere","key":"ifvluwb0r9"},{"type":"text","value":". The fundamental plane in this coordinate system is the Earth’s equatorial plane. The intersection of the Earth’s equatorial plane and the celestial sphere is the ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"PBRwM0AoW6"},{"type":"strong","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"celestial equator","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"IN0f3l2Fnl"}],"key":"mOencQFMZv"},{"type":"text","value":". The coordinates are similar to latitude and longitude on the Earth, but projected out onto the celestial sphere.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"nfTIdpHvDp"}],"key":"yrBVGBideN"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The celestial north and south poles are aligned with the Earth’s north and south poles. The angle from the equator to the poles is called the ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"xfGD8KQ47I"},{"type":"link","url":"https://en.wikipedia.org/wiki/Declination","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"declination","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"bt8bp0EOv3"}],"key":"CBrz8dKh65"}],"urlSource":"https://en.wikipedia.org/wiki/Declination","data":{"page":"Declination","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"hMIgs8f4BK"},{"type":"text","value":". Like latitude, declination is 0° at the celestial equator and ±90° at the poles. Declination is usually abbreviated DEC.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"FZti46C7eT"}],"key":"wXLC7eTlCk"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"The other coordinate is called ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"C3vpv5AnS0"},{"type":"link","url":"https://en.wikipedia.org/wiki/Right_ascension","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"strong","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"right ascension","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"mlPh8h7gNL"}],"key":"XtJqCsgmpC"}],"urlSource":"https://en.wikipedia.org/wiki/Right_ascension","data":{"page":"Right_ascension","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"s7kobOO216"},{"type":"text","value":", abbreviated RA. The zero point of right ascension is at the March, or vernal, equinox and increases going eastward. It takes the Earth about 1 hour to rotate through 15° of right ascension, so lines of right ascension are also called hour lines.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"wFuNod0QyG"}],"key":"cv0RUJZqFc"},{"type":"heading","depth":2,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Ecliptic","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"CKRxGIMoV9"}],"identifier":"ecliptic","label":"Ecliptic","html_id":"ecliptic","implicit":true,"key":"hYO52LVv9N"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Also shown on ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"mOqyLpVUjP"},{"type":"crossReference","identifier":"fig:ra_and_dec_on_celestial_sphere","label":"fig:Ra_and_dec_on_celestial_sphere","kind":"figure","position":{"start":{"line":24,"column":15},"end":{"line":24,"column":50}},"children":[{"type":"text","value":"Fig. ","key":"EgHDkZofHq"},{"type":"text","value":"43","key":"GJVkVIXPj9"}],"template":"Fig. %s","enumerator":"43","resolved":true,"html_id":"fig-ra-and-dec-on-celestial-sphere","key":"OX9oRFnqsF"},{"type":"text","value":" is a line representing the ecliptic. This is the apparent path that the Sun follows through the sky if we measured the right ascension and declination of the Sun at the same time every day. The ecliptic is also the plane of the Earth’s orbit around the Sun. The reason that the Sun does not follow the celestial equator is because the Earth’s rotation axis is tilted by 23.4°.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"FBSgtfvuaH"}],"key":"xuqGSADAsK"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Another way to view the equinox is as the line generated by the intersection of the equatorial plane and the ecliptic plane.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"w0cgPEMJfY"}],"key":"I5zOe7Fvdr"},{"type":"heading","depth":2,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Stars","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"F05o3yAjMc"}],"identifier":"stars","label":"Stars","html_id":"stars","implicit":true,"key":"tweS6M0I8w"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"As seen from the Northern Hemisphere on Earth, any objects with a declination of approximately 90° - ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"DPxJrxZNxN"},{"type":"inlineMath","value":"\\phi","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>ϕ</mi></mrow><annotation encoding=\"application/x-tex\">\\phi</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">ϕ</span></span></span></span>","key":"dLOzGQB9Nt"},{"type":"text","value":", where ","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"I7jZRMvWl2"},{"type":"inlineMath","value":"\\phi","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>ϕ</mi></mrow><annotation encoding=\"application/x-tex\">\\phi</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">ϕ</span></span></span></span>","key":"bPGPA3WW3M"},{"type":"text","value":" is the observer’s latitude, will remain above the horizon all the time. These objects will appear to trace circles around the north celestial pole. The closer an object’s declination is to +90°, the smaller the circle it traces. The star Polaris is currently quite close to the north celestial pole and is known as the North Star. Likewise, the constellation Ursa Minor (the Little Dipper) never sets.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"pnvLFQWhwg"}],"key":"wTnxvWogzD"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Other constellations, such as Orion (and the stars Betelgeuse and Rigel) have declinations of only about +7.5°, so from New England they appear to rise and set each night.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"dHjC7NGQ3h"}],"key":"qQTl7GizlE"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Finally, stars with declinations below about -90° + ","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"xrU4FcCeOo"},{"type":"inlineMath","value":"\\phi","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>ϕ</mi></mrow><annotation encoding=\"application/x-tex\">\\phi</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">ϕ</span></span></span></span>","key":"Ji5ItjCAmR"},{"type":"text","value":" do not rise at all.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"jaxwjHa6zJ"}],"key":"Qe1tJdcHOc"},{"type":"heading","depth":2,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Effects of Precession","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"XEDfxoX3oe"}],"identifier":"effects-of-precession","label":"Effects of Precession","html_id":"effects-of-precession","implicit":true,"key":"QLPv2ErfTg"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"As of the year 2021, the March equinox points in the direction of the constellation Pisces. In antiquity, when the first astronomical observations were recorded, the March equinox was in the constellation of Aries. Thus, the March equinox is also sometimes called the first point of Aries.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"NBLe1ppc3m"}],"key":"ejYRNGRubV"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"This change has occurred due to a phenomenon called ","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"wMdRPDjxWG"},{"type":"link","url":"https://en.wikipedia.org/wiki/Axial_precession","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"axial precession","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"hk8eGghDkr"}],"key":"lk3qRdC4qJ"}],"urlSource":"https://en.wikipedia.org/wiki/Axial_precession","data":{"page":"Axial_precession","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"K400FcldZr"},{"type":"text","value":". Over time, the rotation vector of the Earth changes direction due to the combined pull of the Moon and the Sun on the Earth. Axial precession occurs in a cycle that is approximately 25,700 years long.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"Sr7a5xcf6q"}],"key":"txJavqojoc"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"This means that we need to define where point of 0° right ascension occurs based on the time of the observation. This defines the ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"vH8jnXYJEV"},{"type":"link","url":"https://en.wikipedia.org/wiki/Epoch_(astronomy)","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"epoch","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"z2otrz1L4F"}],"key":"zBoftipBDg"}],"urlSource":"https://en.wikipedia.org/wiki/Epoch_(astronomy)","data":{"page":"Epoch_(astronomy)","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"z75TqkQhTa"},{"type":"text","value":" for the observation. The most common epoch in use today is called the ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"tYkYTNKVYE"},{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"J2000","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"jPHq9SNf3D"}],"key":"hWe1sI17dR"},{"type":"text","value":" epoch.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"um50APPnDm"}],"key":"VYNONCrrGu"},{"type":"aside","children":[{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Since the time of Aristotle, astronomical days start at 12:00 PM (noon) and end at 11:59 AM on the next civil day. This is so that all observations from a single night occur on the same astronomical day, which makes calculations much easier.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"XTQjhwZ5pP"}],"key":"cnr8qWNzGF"}],"key":"BZR162wcZC"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"The J2000 epoch references all coordinates to January 1, 2000 at 12:00 PM (noon). The “J” in J2000 refers to the ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"f5ShmEOXJc"},{"type":"link","url":"https://en.wikipedia.org/wiki/Julian_day","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"strong","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Julian day","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"fW9sON8N2w"}],"key":"UtDGzbUENS"}],"urlSource":"https://en.wikipedia.org/wiki/Julian_day","data":{"page":"Julian_day","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"IWolqA85Be"},{"type":"text","value":", a method of counting time as a continuous number of days, rather than years and months. The zero point for Julian days is in 4731 BCE. Thus, J2000 refers to the Julian day of 2,451,545.0.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"JoxTMaDGDu"}],"key":"cSXl9zpjrt"}],"key":"k1nqGOmTkL"}],"key":"Zj2i5YJTs9"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Perifocal Frame","url":"/classical-orbital-elements/perifocal-frame","group":"The Classical Orbital Elements"},"next":{"title":"Classical Orbital Elements","url":"/classical-orbital-elements/classical-orbital-elements","group":"The Classical Orbital Elements"}}},"domain":"http://pre.render"}