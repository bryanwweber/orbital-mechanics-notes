new file mode 100644
--- /dev/null
+++ b/packages/myst-cli/src/utils/fileInfo.spec.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from 'vitest';
+import { fileInfo } from './fileInfo.js';
+
+describe('folder URL roots', () => {
+  const file = '/project/content/section/page.md';
+  const opts = { projectPath: '/project', urlFolders: true };
+  it('preserves the project root by default', () => {
+    expect(fileInfo(file, {}, opts).slug).toBe('content.section.page');
+  });
+  it('uses an explicit source directory', () => {
+    expect(fileInfo(file, {}, { ...opts, urlRoot: '/project/content' }).slug)
+      .toBe('section.page');
+  });
+  it('keeps flat URLs when folders are disabled', () => {
+    expect(fileInfo(file, {}, { ...opts, urlRoot: '/project/content', urlFolders: false }).slug)
+      .toBe('page');
+  });
+  it('rejects pages outside an explicit root', () => {
+    expect(() => fileInfo(file, {}, { ...opts, urlRoot: '/project/other' }))
+      .toThrow('outside project.url_root');
+  });
+  it('preserves the fallback for files outside the project without an explicit root', () => {
+    expect(fileInfo('/other/page.md', {}, opts).slug).toBe('page');
+  });
+});
